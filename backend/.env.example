# Copy to .env for local development. Render sets these as environment
# variables in the dashboard instead.

ENVIRONMENT=development
DEBUG=true

# Local development uses SQLite. In production this is the SiteGround
# PostgreSQL connection string, e.g.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./race.db

# Signs login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Encrypts API keys stored in the settings table. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be set in production - Render's disk is ephemeral, so a generated key
# would be lost on redeploy and every stored API key would become unreadable.
SETTINGS_ENCRYPTION_KEY=

# Created on first boot if absent; promoted to admin if the account exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

CORS_ORIGINS=http://localhost:5173,https://exam.txglobal.com.au
