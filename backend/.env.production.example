# Production secrets. Copy this file to `.env.production` and fill it in.
#
# `.env.production` is git-ignored, so anything you put there stays on your
# machine and never reaches GitHub or a chat transcript. Write the real values
# in that file rather than pasting them into a message.

# From Site Tools > Site > PostgreSQL.
# Keep the "+psycopg" part. Use a password with letters and numbers only -
# characters like @ : / ? # & have meaning inside a URL and cause confusing
# authentication failures.
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Site Tools > Devs > SSH Keys Manager, for uploading the built front end.
SITEGROUND_SSH_HOST=
SITEGROUND_SSH_USER=
SITEGROUND_SSH_PORT=18765

# The document root for exam.txglobal.com.au on the SiteGround server.
SITEGROUND_REMOTE_PATH=~/www/exam.txglobal.com.au/public_html

# The Render service URL, once it exists (no trailing slash).
RENDER_API_URL=
