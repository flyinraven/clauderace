# SiteGround / Apache configuration for the RACE Exam Simulator front end.

# --- Single-page app routing ---------------------------------------------
# React Router owns the URLs, so /osce and /exams must serve index.html rather
# than being looked up on disk.
#
# FallbackResource is used in preference to a mod_rewrite block: on this host
# mod_rewrite rules are silently ignored inside .htaccess (headers below apply
# fine, rewrites never fire), which left every deep link returning 403.
# FallbackResource is mod_dir and does the same job in one line.
Options -MultiViews
DirectoryIndex index.html
FallbackResource /index.html

# Kept as a fallback for any host where mod_rewrite does work and mod_dir's
# FallbackResource is unavailable. Harmless when FallbackResource has already
# handled the request.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- Caching --------------------------------------------------------------
# Vite fingerprints asset filenames, so they can be cached indefinitely.
# index.html must never be cached or a deploy would not reach returning users.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # This is private study material; keep it out of search results.
  Header set X-Robots-Tag "noindex, nofollow"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- HTTPS ----------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Compression ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
